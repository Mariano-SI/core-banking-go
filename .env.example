# Application environment: development or production.
APP_ENV=development

# Port the HTTP server listens on.
HTTP_PORT=8080

# Minimum log level: debug, info, warn or error.
LOG_LEVEL=info

# PostgreSQL (docker-compose).
POSTGRES_USER=core_banking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=core_banking
POSTGRES_PORT=5432

# Keycloak (docker-compose). Admin console: http://localhost:8081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8081

# Connection string used by the migrations and, later, by the API.
DATABASE_URL=postgres://core_banking:change-me@localhost:5432/core_banking?sslmode=disable
